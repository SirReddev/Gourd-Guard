{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": [
          "firework_cannon",
          "gourdguard_tower_firework_cannon"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "gourd_guard:item/tower_firework_cannon"
        }
      },
      {
        "when": [
          "copper_golem_launcher",
          "gourdguard_tower_copper_golem_launcher"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "gourd_guard:item/tower_copper_golem_launcher"
        }
      },
      {
        "when": [
          "pillager_convoy",
          "gourdguard_tower_pillager_convoy"
        ],
        "model": {
          "type": "minecraft:model",
          "model": "gourd_guard:item/tower_pillager_convoy"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/armor_stand"
    }
  }
}