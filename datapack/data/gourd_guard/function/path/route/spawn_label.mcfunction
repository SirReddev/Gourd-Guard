# Pathfinding - Summon a temporary floating 3D label above a path_node showing its exact Branch & Node #
# Executed as and at @e[tag=path_node]

scoreboard players operation #lbl_node path.cmp = @s path.node
scoreboard players operation #lbl_route path.cmp = @s path.route

execute if score @s path.branch matches 0 run summon minecraft:text_display ~ ~1.2 ~ {billboard:"center",see_through:1b,background:1879048192,Tags:["path_debug_label"],text:[{text:"[P",color:"gray"},{score:{name:"#lbl_route",objective:"path.cmp"},color:"white"},{text:" Start #",color:"aqua",bold:true},{score:{name:"#lbl_node",objective:"path.cmp"},color:"white",bold:true},{text:"]",color:"aqua",bold:true}]}
